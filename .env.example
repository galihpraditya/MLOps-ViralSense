# Kredensial API Eksternal
YOUTUBE_API_KEY=your_google_youtube_api_key_here

# Konfigurasi Scraping & Anti-Rate Limit
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SCRAPER_DELAY_SECONDS=3

# MLOps Remote Storage & Tracking (DagsHub / S3 / Google Drive)
DAGSHUB_USERNAME=your_dagshub_username
DAGSHUB_TOKEN=your_dagshub_token
DVC_REMOTE_URL=https://dagshub.com/your_dagshub_username/MLOps-ViralSense.dvc
# Kredensial Scraping Tambahan (Opsional)
# Apify Free Tier ($5/bulan gratis): Token dari https://apify.com/ untuk fallback scraper
APIFY_API_TOKEN=

